# Copie para .env e ajuste. O .env NUNCA vai para o Git.

# api = envia para a API Java | dry-run = so registra em saida/leituras.csv
MODO=dry-run

# Broker MQTT (demo: HiveMQ publico, sem autenticacao)
MQTT_BROKER=broker.hivemq.com
MQTT_PORTA=1883
MQTT_TLS=false
MQTT_USUARIO=
MQTT_SENHA=

# API GuardaRio (Java). Na VM Azure: http://IP-PUBLICO:8080
API_URL=http://localhost:8080
# Usuario tecnico com papel AGENTE (criado pelo ADMIN na API)
API_EMAIL=agente@guardario.com
API_SENHA=

# codigo_da_estacao:id_na_api, separados por virgula
ESTACOES=GR-SP-001:1

# Cotas usadas para conferir a regua (atencao,alerta,transbordo em cm)
COTAS=250,300,340

INTERVALO_METRICAS_S=60
